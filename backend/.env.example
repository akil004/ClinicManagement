# Copy this file to .env and fill in real values. Never commit the real .env.

# ── Server ───────────────────────────────────────────────
PORT=5000

# ── Database ─────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/hospital_management

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── CORS / frontend ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Application ──────────────────────────────────────────
APP_NAME=Hospital Management System
APP_TIMEZONE=Asia/Kolkata

# ── Doctor online/offline presence ───────────────────────
# Minutes of inactivity after which a doctor with no heartbeat is
# automatically marked offline (see server.js sweep + authController.heartbeat).
DOCTOR_ONLINE_TIMEOUT_MINUTES=10

# ── Pagination ───────────────────────────────────────────
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# ── Request limits ───────────────────────────────────────
JSON_BODY_LIMIT=10mb

# ── Initial administrator account (used only by `npm run seed:admin`) ──
# There is no public sign-up — this is the only way to provision the first
# Administrator. Change the password after first login.
ADMIN_NAME=Hospital Administrator
ADMIN_EMAIL=admin@hospital.com
ADMIN_PASSWORD=Admin@12345
